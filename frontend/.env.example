# =================================================================
# Frontend Environment Variables Template (Vite)
# Copy this file to .env and insert your web application config from
# Firebase Console -> Project Settings -> General -> Your apps -> Web app
# =================================================================

# Backend API base URL (empty if using Vite proxy)
VITE_API_BASE_URL=

# Firebase Client Web SDK Configuration (Safe for frontend bundle)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
