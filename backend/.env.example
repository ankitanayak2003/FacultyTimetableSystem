# =================================================================
# Faculty Workload & Timetable Management System - Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file or credentials to source control!
# =================================================================

# Application Server Settings
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Firebase Cloud Firestore & Admin Authentication Settings
# Path to the downloaded service account JSON file (relative to backend folder or absolute path)
# Example: secrets/serviceAccountKey.json
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# Optional Google Gemini API Configuration (for natural language timetable queries)
GEMINI_API_KEY=
